{
  "name": "@microsoft/opentelemetry-browser",
  "version": "0.1.0-beta.1",
  "description": "OpenTelemetry distribution for the browser",
  "license": "MIT",
  "type": "module",
  "main": "./dist/commonjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.cts",
        "default": "./dist/commonjs/index.cjs"
      }
    },
    "./instrumentations": {
      "import": {
        "types": "./dist/esm/instrumentations.d.ts",
        "default": "./dist/esm/instrumentations.js"
      },
      "require": {
        "types": "./dist/commonjs/instrumentations.d.cts",
        "default": "./dist/commonjs/instrumentations.cjs"
      }
    },
    "./snippet": {
      "import": {
        "types": "./dist/esm/snippet.d.ts",
        "default": "./dist/esm/snippet.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/opentelemetry-distro-browser.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && rollup --config && node scripts/cdn.mjs",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:check": "npm run format",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:install-browsers": "playwright install chromium firefox webkit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:build": "node --test test/build/package.test.mjs test/build/size-harness.test.mjs test/build/cdn.test.mjs test/build/cdn-aliases.test.mjs",
    "test:report": "node --test test/report/coverage.test.mjs && python -m unittest discover -s test/report -p *_test.py",
    "api:check": "api-extractor run && api-extractor run --config api-extractor.instrumentations.json && api-extractor run --config api-extractor.snippet.json",
    "api:update": "npm run build && api-extractor run --local && api-extractor run --local --config api-extractor.instrumentations.json && api-extractor run --local --config api-extractor.snippet.json",
    "cdn:publish": "node scripts/publish-cdn.mjs",
    "cdn:activate": "node scripts/activate-cdn.mjs",
    "cdn:verify": "node scripts/verify-cdn.mjs",
    "size": "node scripts/measure-bundle-size.mjs",
    "size:compare": "node scripts/compare-bundle-size.mjs",
    "size:report": "npm run size",
    "perf": "node scripts/perf/run.mjs",
    "perf:export": "node scripts/perf/export.mjs",
    "test:perf": "node --test test/perf/*.test.mjs",
    "check": "npm run format && npm run lint && npm run docs && npm run typecheck && npm run test:report && npm run test:perf && npm run test:unit && npm run test:coverage && npm run build && npm run test:build && npm run test:integration && npm run test:e2e && npm run api:check && npm run size",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/browser-instrumentation": "0.8.1",
    "@opentelemetry/browser-sdk": "0.4.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.1 <1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@opentelemetry/api": "1.9.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "acorn": "^8.18.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "4.0.1",
    "globals": "^17.12.0",
    "magic-string": "^0.30.21",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.5"
  }
}
